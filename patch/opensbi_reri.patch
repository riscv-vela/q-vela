+
+#ifndef __ACPI_GHES_H
+#define __ACPI_GHES_H
+
+typedef struct {
+	uint32_t etype;
+	union {
+		struct {
+			uint32_t  validation_bits;
+			uint32_t  sev;
+			uint8_t   proc_type;
+			uint8_t   proc_isa;
+			uint8_t   proc_err_type;
+			uint8_t   operation;
+			uint8_t   flags;
+			uint8_t   level;
+			uint64_t  cpu_version;
