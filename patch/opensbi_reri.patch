+enum einj_err_type_bit_pos {
+	proc_correctable,
+	proc_uncorrectable_non_fatal,
+	proc_uncorrectable_fatal,
+	mem_correctable,
+	mem_uncorrectable_non_fatal,
+	mem_uncorrectable_fatal,
