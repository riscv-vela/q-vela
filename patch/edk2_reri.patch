-  Fcb = SEMIHOST_FCB_FROM_THIS (File);
-
-  if (Fcb->IsRoot) {
-    return EFI_SUCCESS;
-  } else {
-    if (  (Fcb->Info.Attribute & EFI_FILE_READ_ONLY)
