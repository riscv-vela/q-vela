diff -ruN edk2/MdePkg/Library/ArmSmcLib/Arm/ArmSmc.S edk2-reri/MdePkg/Library/ArmSmcLib/Arm/ArmSmc.S
--- edk2/MdePkg/Library/ArmSmcLib/Arm/ArmSmc.S	1970-01-01 09:00:00.000000000 +0900
+++ edk2-reri/MdePkg/Library/ArmSmcLib/Arm/ArmSmc.S	2025-10-29 20:01:52.061233002 +0900
@@ -0,0 +1,44 @@
+//
+//  Copyright (c) 2012-2014, ARM Limited. All rights reserved.
+//
+//  SPDX-License-Identifier: BSD-2-Clause-Patent
+//
+//
+
+#include <AsmMacroLib.h>
+
+.arch_extension sec
+
+ASM_FUNC(ArmCallSmc)
+    push    {r4-r8}
+    // r0 will be popped just after the SMC call
+    push    {r0}
+
+    // Load the SMC arguments values into the appropriate registers
+    ldr     r7, [r0, #28]
+    ldr     r6, [r0, #24]
+    ldr     r5, [r0, #20]
+    ldr     r4, [r0, #16]
+    ldr     r3, [r0, #12]
+    ldr     r2, [r0, #8]
+    ldr     r1, [r0, #4]
+    ldr     r0, [r0, #0]
+
+    smc     #0
+
+    // Pop the ARM_SMC_ARGS structure address from the stack into r8
+    pop     {r8}
+
+    // Load the SMC returned values into the appropriate registers
+    // A SMC call can return up to 4 values - we do not need to store back r4-r7.
+    str     r3, [r8, #12]
+    str     r2, [r8, #8]
+    str     r1, [r8, #4]
+    str     r0, [r8, #0]
+
+    mov     r0, r8
+
+    // Restore the registers r4-r8
+    pop     {r4-r8}
+
+    bx      lr
