-**/
-VOID
-EFIAPI
-ParseAcpiAgdi (
-  IN BOOLEAN  Trace,
-  IN UINT8    *Ptr,
-  IN UINT32   AcpiTableLength,
-  IN UINT8    AcpiTableRevision
-  )
-{
-  if (!Trace) {
-    return;
-  }
-
-  // Parse ACPI Header + RASF "fixed" fields
-  ParseAcpi (
-    Trace,
-    0,
-    "AGDI",
-    Ptr,
-    AcpiTableLength,
-    PARSER_PARAMS (AgdiParser)
-    );
-}
