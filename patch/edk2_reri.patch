-    Return = SemihostFileSeek (Fcb->SemihostHandle, MIN (Position, Fcb->Info.FileSize));
-    if (RETURN_ERROR (Return)) {
-      return EFI_DEVICE_ERROR;
-    }
-  }
-
-  Fcb->Position = Position;
-
-  return EFI_SUCCESS;
-}
