-
-    if (*BufferSize >= ResultSize) {
-      CopyMem (Buffer, mSemihostFsLabel, ResultSize);
-      Status = EFI_SUCCESS;
-    } else {
-      Status = EFI_BUFFER_TOO_SMALL;
-    }
-
-    *BufferSize = ResultSize;
-  } else {
-    Status = EFI_UNSUPPORTED;
-  }
