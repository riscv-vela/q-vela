diff -ruN edk2/MdePkg/Include/Library/DxeRiscvMpxy.h edk2-reri/MdePkg/Include/Library/DxeRiscvMpxy.h
--- edk2/MdePkg/Include/Library/DxeRiscvMpxy.h	1970-01-01 09:00:00.000000000 +0900
