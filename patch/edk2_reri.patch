diff -ruN edk2/ArmVirtPkg/PrePi/AArch64/ArchPrePi.c edk2-reri/ArmVirtPkg/PrePi/AArch64/ArchPrePi.c
--- edk2/ArmVirtPkg/PrePi/AArch64/ArchPrePi.c	1970-01-01 09:00:00.000000000 +0900
+++ edk2-reri/ArmVirtPkg/PrePi/AArch64/ArchPrePi.c	2025-10-29 20:01:51.755152514 +0900
