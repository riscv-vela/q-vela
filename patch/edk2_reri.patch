-  IN      CONST UINTN                                              TableCount
-  )
-{
-  UINTN             Index;
-  SMBIOS_STRUCTURE  **TableList;
-
-  TableList = *Table;
-  for (Index = 0; Index < TableCount; Index++) {
-    if (TableList[Index] != NULL) {
