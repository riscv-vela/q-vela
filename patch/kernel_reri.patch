+++ linux-reri/drivers/hwtracing/Kconfig	2025-10-29 19:45:49.538988407 +0900
@@ -7,4 +7,6 @@
 
 source "drivers/hwtracing/ptt/Kconfig"
 
+source "drivers/hwtracing/rvtrace/Kconfig"
+
